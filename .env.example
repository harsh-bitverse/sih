# Workbench System Configuration
WORKBENCH_ENV=development
LOG_LEVEL=INFO

# Security & Audit
AUDIT_LOG_DIR=logs/audit
ZERO_EGRESS_ENFORCED=true

# Model Serving & Registry Configuration
MODEL_REGISTRY_CONFIG=configs/models/registry.yaml

# Storage Paths
DATA_STORAGE_DIR=data/sample
OUTPUT_STORAGE_DIR=outputs
